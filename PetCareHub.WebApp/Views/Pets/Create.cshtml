@model PetCareHub.WebApp.Models.CreatePetRequest
@{
    ViewData["Title"] = "Add Pet";
}

<div class="max-w-xl">
    <div class="mb-6">
        <a href="/Pets" class="text-sm text-gray-500 hover:text-gray-700">← Back to Pets</a>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">Add New Pet</h1>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Create" method="post" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5">
        <div asp-validation-summary="All" class="text-sm text-red-700"></div>
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
            <input asp-for="Name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" placeholder="e.g. Max" required />
        </div>

        <div>
            <label asp-for="Species" class="block text-sm font-medium text-gray-700 mb-1">Species *</label>
            <select asp-for="Species" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required>
                <option value="">Select species</option>
                <option value="Dog">Dog</option>
                <option value="Cat">Cat</option>
                <option value="Bird">Bird</option>
                <option value="Rabbit">Rabbit</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div>
            <label asp-for="Breed" class="block text-sm font-medium text-gray-700 mb-1">Breed</label>
            <input asp-for="Breed" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" placeholder="e.g. Golden Retriever" />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="DateOfBirth" class="block text-sm font-medium text-gray-700 mb-1">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" />
            </div>
            <div>
                <label asp-for="Gender" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                <select asp-for="Gender" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500">
                    <option value="">Select</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
        </div>

        <div>
            <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
            <textarea asp-for="Notes" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" placeholder="Any extra notes..."></textarea>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700 transition">
                Create Pet
            </button>
            <a href="/Pets" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
                Cancel
            </a>
        </div>
    </form>
</div>
