@model PetCareHub.WebApp.Models.PetProfileRequest
@{
    ViewData["Title"] = "Edit Pet";
    var petId = ViewContext.RouteData.Values["id"];
}

<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Pet</h1>

    <form asp-action="Edit" asp-route-id="@petId" method="post" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5">
        <div asp-validation-summary="All" role="alert" class="text-sm text-red-700"></div>
        <partial name="_PetFields" />

        <div>
            <label asp-for="PhotoUrl" class="block text-sm font-medium text-gray-700 mb-1">Photo URL</label>
            <input asp-for="PhotoUrl" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" />
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700">Save changes</button>
            <a asp-action="Details" asp-route-id="@petId" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200">Cancel</a>
        </div>
    </form>
</div>
