@using PetCareHub.WebApp.Models
@{
    ViewData["Title"] = "Dashboard";
    var pets = ViewBag.Pets as List<PetDto> ?? new();
    var reminders = ViewBag.Reminders as List<ReminderDto> ?? new();
}

<div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
    <p class="text-gray-500 mt-1">Overview of your pets and upcoming care tasks</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Total Pets</p>
                <p class="text-3xl font-bold text-gray-900 mt-1">@ViewBag.PetCount</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-sky-100 flex items-center justify-center text-2xl">🐶</div>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Upcoming Reminders</p>
                <p class="text-3xl font-bold text-gray-900 mt-1">@ViewBag.ReminderCount</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-2xl">🔔</div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="font-semibold text-gray-900">Your Pets</h2>
            <a href="/Pets/Create" class="text-sm text-sky-600 hover:text-sky-700 font-medium">+ Add Pet</a>
        </div>
        <div class="p-5">
            @if (!pets.Any())
            {
                <p class="text-gray-500 text-sm">No pets yet. <a href="/Pets/Create" class="text-sky-600 hover:underline">Create your first pet</a></p>
            }
            else
            {
                <ul class="space-y-3">
                    @foreach (var pet in pets.Take(5))
                    {
                        <li class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-lg">
                                    @(pet.Species.ToLower().Contains("cat") ? "🐱" : "🐶")
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">@pet.Name</p>
                                    <p class="text-xs text-gray-500">@pet.Species</p>
                                </div>
                            </div>
                            <a href="/Pets/Details/@pet.Id" class="text-sm text-sky-600 hover:underline">View</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="font-semibold text-gray-900">Upcoming Reminders</h2>
            <a href="/Reminders/Create" class="text-sm text-sky-600 hover:text-sky-700 font-medium">+ Add</a>
        </div>
        <div class="p-5">
            @if (!reminders.Any())
            {
                <p class="text-gray-500 text-sm">No upcoming reminders.</p>
            }
            else
            {
                <ul class="space-y-3">
                    @foreach (var r in reminders.Take(5))
                    {
                        <li class="flex items-start justify-between gap-3">
                            <div>
                                <p class="font-medium text-gray-900 text-sm">@r.Title</p>
                                <p class="text-xs text-gray-500">@r.PetName • Due @r.DueDate.ToString("MMM dd, yyyy")</p>
                            </div>
                            <form asp-controller="Reminders" asp-action="Complete" method="post">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="text-xs px-2 py-1 rounded bg-green-50 text-green-700 hover:bg-green-100">Done</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
