@model PetCareHub.WebApp.Models.ReminderEditFields
@{
    ViewData["Title"] = "Edit Reminder";
}

<div class="max-w-xl">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Reminder</h1>

    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5">
        <div asp-validation-summary="All" class="text-sm text-red-700" role="alert"></div>
        <partial name="_ReminderFields" />

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700">Save changes</button>
            <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200">Cancel</a>
        </div>
    </form>
</div>
