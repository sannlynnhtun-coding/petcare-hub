@model PetCareHub.WebApp.Models.ReminderEditFields

<div>
    <label asp-for="Type" class="block text-sm font-medium text-gray-700 mb-1">Type *</label>
    <select asp-for="Type" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500">
        @foreach (var type in ReminderTypes.All)
        {
            <option value="@type">@type</option>
        }
        @if (!string.IsNullOrEmpty(Model.Type) && !ReminderTypes.All.Contains(Model.Type, StringComparer.OrdinalIgnoreCase))
        {
            <option value="@Model.Type">@Model.Type</option>
        }
    </select>
</div>

<div>
    <label asp-for="Title" class="block text-sm font-medium text-gray-700 mb-1">Title *</label>
    <input asp-for="Title" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="e.g. Annual rabies vaccine" required />
</div>

<div>
    <label asp-for="DueDate" class="block text-sm font-medium text-gray-700 mb-1">Due Date *</label>
    <input asp-for="DueDate" type="date" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" required />
</div>

<div>
    <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
    <textarea asp-for="Notes" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Optional notes..."></textarea>
</div>
