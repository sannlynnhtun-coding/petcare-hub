@model PetCareHub.WebApp.Models.CreateReminderRequest
@using PetCareHub.WebApp.Models
@{
    ViewData["Title"] = "Add Reminder";
    var pets = ViewBag.Pets as List<PetDto> ?? new();
}

<div class="max-w-xl">
    <div class="mb-6">
        <a href="/Reminders" class="text-sm text-gray-500 hover:text-gray-700">← Back to Reminders</a>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">Add Reminder</h1>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm">
            @ViewBag.Error
        </div>
    }

    @if (!pets.Any())
    {
        <div class="bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-amber-800 text-sm mb-4">
            You need to create a pet first before adding reminders.
            <a href="/Pets/Create" class="underline font-medium">Create a pet</a>
        </div>
    }

    <form method="post" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 space-y-5">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Pet *</label>
            <select asp-for="PetId" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" required>
                <option value="">Select a pet</option>
                @foreach (var pet in pets)
                {
                    <option value="@pet.Id">@pet.Name (@pet.Species)</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Type *</label>
            <select asp-for="Type" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500">
                <option value="Vaccination">Vaccination</option>
                <option value="Medicine">Medicine</option>
                <option value="Grooming">Grooming</option>
                <option value="Checkup">Checkup</option>
                <option value="Custom">Custom</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Title *</label>
            <input asp-for="Title" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="e.g. Annual rabies vaccine" required />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Due Date *</label>
            <input asp-for="DueDate" type="date" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" required />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
            <textarea asp-for="Notes" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500" placeholder="Optional notes..."></textarea>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700 transition" @(pets.Any() ? "" : "disabled")>
                Create Reminder
            </button>
            <a href="/Reminders" class="px-5 py-2.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
                Cancel
            </a>
        </div>
    </form>
</div>
