<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetCare Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 50: '#f0f9ff', 100: '#e0f2fe', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between sm:items-center sm:min-h-16">
                <div class="flex flex-col sm:flex-row sm:items-center sm:gap-8">
                    <a href="/" class="flex items-center gap-2">
                        <span class="text-2xl">🐾</span>
                        <span class="font-bold text-xl text-gray-900">PetCare Hub</span>
                    </a>
                    <div class="flex flex-wrap gap-1">
                        <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100">Dashboard</a>
                        <a href="/Pets" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100">Pets</a>
                        <a href="/Reminders" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100">Reminders</a>
                    </div>
                </div>
                <div class="hidden sm:block text-sm text-gray-500">MVP • Learning Project</div>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-green-800 text-sm">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div role="alert" class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm">
                @error
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-t border-gray-200 mt-12 py-6">
        <div class="max-w-6xl mx-auto px-4 text-center text-sm text-gray-500">
            PetCare Hub MVP — Built for learning Design Patterns
        </div>
    </footer>
</body>
</html>
